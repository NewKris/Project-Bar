      value: Click me to continue.
      objectReference: {fileID: 0}
    - target: {fileID: 6672725777763676241, guid: e49708223bec4b342b3f53e2652642b5, type: 3}
      propertyPath: tutorialSteps.Array.data[11].reminderDialogue
      value: Click the Poison Ampoule to Continue, kid.
      objectReference: {fileID: 0}
    - target: {fileID: 6672725777763676241, guid: e49708223bec4b342b3f53e2652642b5, type: 3}
      propertyPath: tutorialSteps.Array.data[12].reminderDialogue
      value: Look at the <color=red>Poison Ampoule to see its Shortcut</color>, and
        serve me a <color=blue>Blow My Skull with Poison</color>.
      objectReference: {fileID: 0}
    - target: {fileID: 6672725777763676241, guid: e49708223bec4b342b3f53e2652642b5, type: 3}
      propertyPath: tutorialSteps.Array.data[13].reminderDialogue
      value: Click me so we can wrap this up, and you can start working.
      objectReference: {fileID: 0}
    - target: {fileID: 6672725777763676241, guid: e49708223bec4b342b3f53e2652642b5, type: 3}
