  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Cocktail Menu, level 2\n1.  Blow my skull (Whiskey glass): Beer, rum\n2. 
    Cuba libre (Whiskey glass): Ice, rum, cola\n3.  Daiquiri (Martini glass): Sugar,
    ice, rum, lime slice\nDark'n'Stormy (Whiskey glass): Ice, Rum, Ginger Beer, Lime
    Juice, Lime Slice\n4.  Gimlet (Martini  glass): Gin, Lime juice, Lime slice\n5. 
    Kamikaze (Chilled Martini glass): Vodka, Triple Sec, lime juice, [Shake], Lime
    slice\nMaiden's Prayer (Martini glass): Ice, Gin, Triple sec, Lime Juice, Orange
    Juice, [Shake] \n6.  Margarita (Martini glass): Salt, ice, tequila, triple sec,
    lime juice, lime slice\n7.  Marquisette (Martini glass): Sugar, white wine, rum,
    lime juice, [Shake], lime slice\n8.  Mojito (Martini glass): Ice, rum, lime slice,
    mint\n9.  Moscow Mule (Copper Mug): Ice, vodka, ginger beer, lime slice\n10.
    Screwdriver (Whiskey glass): Ice, vodka, orange juice\n11. Shandygaff (Copper
    Mug): Beer, ginger beer\n12. Tequila slammer (Whiskey glass): Ice, tequila, ginger
    beer, [Shake]"
