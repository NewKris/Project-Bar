.root {
    
}

.box {
    width: 100%;
    background-color: #1b1b1b;
    border-radius: 10px;
    margin-bottom: 10px;
    padding: 10px;
}

.box-title {
    width: 100%;
    height: 25px;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.ingredient-list {
    flex-direction: row;
    align-items: flex-start;
}

.ingredient-group {
    width: 50px;
    height: 50px;
    background-color: red;
    margin: 5px;
}